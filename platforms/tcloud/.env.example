# meshStack Configuration
MESHSTACK_MESHFED_URL=https://meshfed.example.com
MESHSTACK_KRAKEN_URL=https://kraken.example.com
MESHSTACK_API_USER=mesh-custom-metering
MESHSTACK_API_SECRET=your-secret-here
PLATFORM_ID=tcloud.production

# T-Cloud Authentication
# API key created in the Financial Dashboard (Configuration > API Keys) with security level "Admin".
# Keys are valid for at most 90 days and must be rotated.
TCLOUD_API_TOKEN=your-financial-dashboard-api-key

# Optional: override the Financial Dashboard API base URL
# TCLOUD_API_BASE_URL=https://api-enterprise-dashboard.otc-service.com

# Optional: restrict to specific T-Cloud contract numbers (comma-separated).
# When unset, consumption for all contracts visible to the API key is fetched in one request.
# TCLOUD_CONTRACT_IDS=1000012345,1000067890

# Optional: fetch and transform against the live API but do not submit to meshStack
TCLOUD_DRY_RUN=false

# Optional Configuration
USAGE_PERIOD=2024-01
LOG_LEVEL=INFO
LOKI_URL=http://loki:3100
